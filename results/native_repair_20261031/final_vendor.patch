+    h.sink_base=d.rr_indexed_data[RRIndexedDataId(SINK_COST_INDEX)].base_cost;
+    h.reserved=SINK_COST_INDEX;
+    h.sentinel=ROUTER_LOOKAHEAD_NO_PATH_SENTINEL;h.base_count=d.rr_indexed_data.size();
+    model.wires.reserve(uint64_t(h.layers)*h.layers*h.channels*h.segments*h.width*h.height);
+    for(uint32_t from=0;from<h.layers;++from)for(uint32_t to=0;to<h.layers;++to)
+    for(uint32_t type=0;type<h.channels;++type)for(uint32_t seg=0;seg<h.segments;++seg)
+    for(uint32_t x=0;x<h.width;++x)for(uint32_t y=0;y<h.height;++y){
