+    using namespace h3d_native;
+    const auto& d=g_vpr_ctx.device();const auto& rr=d.rr_graph;
+    auto kind=[](e_rr_type t)->uint32_t {
+        switch(t){
+            case e_rr_type::SOURCE:return Source;case e_rr_type::SINK:return Sink;
+            case e_rr_type::IPIN:return Ipin;case e_rr_type::OPIN:return Opin;
+            case e_rr_type::CHANX:return ChanX;case e_rr_type::CHANY:return ChanY;case e_rr_type::CHANZ:return ChanZ;
