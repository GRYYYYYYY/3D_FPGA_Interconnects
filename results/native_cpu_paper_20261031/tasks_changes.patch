+std::vector<t_routing_cost_map> get_routing_cost_maps_pipeline(
+    int longest_seg_length, const std::vector<WireSampleGroup>& groups,
+    int route_verbosity, bool device_model_warnings) {
+    const auto& device_ctx = g_vpr_ctx.device();
+    const auto& grid = device_ctx.grid;
+    std::vector<t_routing_cost_map> results(groups.size());
+#ifdef VPR_USE_TBB
+    using Clock = std::chrono::steady_clock;
+    const char* profile_path = std::getenv("VPR_HYBRID_LOOKAHEAD_REPORT");
+    auto start = profile_path ? Clock::now() : Clock::time_point{};
+    struct Job {
+        size_t group;
+        RRNodeId node;
+    };
+    struct SampleResult {
+        Job job;
+        t_routing_cost_map costs;
+    };
+    std::vector<Job> jobs;
+    for (size_t i = 0; i < groups.size(); ++i) {
+        const auto& group = groups[i];
+        if (!device_ctx.inter_cluster_prog_routing_resources[group.from_layer]) continue;
+        results[i] = t_routing_cost_map({grid.get_num_layers(), grid.width(), grid.height()});
+        auto nodes = select_wire_samples(longest_seg_length, group.from_layer, group.channel, *group.segment);
+        if (nodes.empty()) {
+            VTR_LOGV_WARN(route_verbosity > 1 || device_model_warnings,
+                          "Unable to find any sample location for segment %s type '%s' (length %d)\n",
+                          rr_node_typename[group.channel], group.segment->name.c_str(), group.segment->length);
+        }
+        for (auto node : nodes) jobs.push_back({i, node});
+    }
+    /** The token bound limits in-flight sample maps to twice the caller's CPU
+     * budget. Scratch is shared across groups only by the same worker thread.
+     * Neither the graph nor another worker's labels are modified. */
+    const size_t tokens = std::min(jobs.size(), std::max(size_t(1),
+        2 * tbb::global_control::active_value(tbb::global_control::max_allowed_parallelism)));
+    tbb::enumerable_thread_specific<t_dijkstra_data> scratch;
+    size_t next = 0;
+    using Result = std::shared_ptr<SampleResult>;
+    if (!jobs.empty()) {
+        tbb::parallel_pipeline(tokens,
+            tbb::make_filter<void, Result>(tbb::filter_mode::serial_in_order,
+                [&](tbb::flow_control& flow) -> Result {
+                    if (next == jobs.size()) {
+                        flow.stop();
+                        return {};
+                    }
+                    return std::make_shared<SampleResult>(SampleResult{jobs[next++], {}});
+                }) &
+            tbb::make_filter<Result, Result>(tbb::filter_mode::parallel,
+                [&](Result sample) -> Result {
+                    auto& local = scratch.local();
+                    local.profile = profile_path != nullptr;
+                    sample->costs = t_routing_cost_map({grid.get_num_layers(), grid.width(), grid.height()});
+                    flood_wire_sample(sample->job.node, local, sample->costs, {}, true);
+                    return sample;
+                }) &
+            tbb::make_filter<Result, void>(tbb::filter_mode::serial_in_order,
+                [&](Result sample) {
+                    auto& target = results[sample->job.group];
+                    // The global token order also preserves order within every
+                    // group, including the original equal-delay congestion tie.
+                    for (size_t layer = 0; layer < grid.get_num_layers(); ++layer) {
+                        for (size_t x = 0; x < grid.width(); ++x) {
+                            for (size_t y = 0; y < grid.height(); ++y) {
+                                target[layer][x][y].merge_smallest(sample->costs[layer][x][y]);
+                            }
+                        }
+                    }
+                }));
+    }
+    if (profile_path) {
+        uint64_t init_ns = 0, search_ns = 0, floods = 0;
+        for (const auto& local : scratch) {
+            init_ns += local.init_ns;
+            search_ns += local.search_ns;
+            floods += local.floods;
+        }
+        std::ofstream report(profile_path, std::ios::app);
+        report << "{\"scheduler\":\"ordered_pipeline\",\"groups\":" << groups.size()
+               << ",\"samples\":" << jobs.size() << ",\"tokens\":" << tokens
+               << ",\"workspaces\":" << scratch.size() << ",\"floods\":" << floods
+               << ",\"init_ns\":" << init_ns << ",\"search_ns\":" << search_ns
+               << ",\"wall_ns\":" << std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() - start).count()
+               << "}\n";
+    }
+#else
+    // The same opt-in remains functional in builds without TBB.
+    for (size_t i = 0; i < groups.size(); ++i) {
+        const auto& group = groups[i];
+        results[i] = get_routing_cost_map(longest_seg_length, group.from_layer, group.channel,
+                                         *group.segment, {}, true, route_verbosity, device_model_warnings);
+    }
+#endif
+    return results;
 }
 
