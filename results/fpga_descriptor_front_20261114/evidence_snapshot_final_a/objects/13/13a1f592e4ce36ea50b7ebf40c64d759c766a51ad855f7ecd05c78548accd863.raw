  "arithmetic_stages": 6,
  "minimum_operand_capture_to_consumer_edges": 6,
  "same_edge_replacement": "elastic pipe/context holds only, not token/E/slot allocation",
  "token_release": "one percycle afterboth recorded branchhandoffs, plus independent stalePOP release",
  "outputbank_scope": "targetcapture includes physical payload and backpressure; shared8bank output service outside localDUT",
