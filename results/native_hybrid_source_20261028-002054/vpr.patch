+bool MapLookahead::export_hybrid_model(h3d_native::Model& model) const {
+    if (is_flat_ || has_interposer_cuts_) return false;
+    using namespace h3d_native;
+    const auto& d=g_vpr_ctx.device();const auto& rr=d.rr_graph;
+    auto kind=[](e_rr_type t)->uint32_t {
+        switch(t){
+            case e_rr_type::SOURCE:return Source;case e_rr_type::SINK:return Sink;
+            case e_rr_type::IPIN:return Ipin;case e_rr_type::OPIN:return Opin;
+            case e_rr_type::CHANX:return ChanX;case e_rr_type::CHANY:return ChanY;case e_rr_type::CHANZ:return ChanZ;
+            default:throw std::runtime_error("unsupported native RR node kind");
+        }
+    };
+    auto& h=model.header;
+    h.width=d.grid.width();h.height=d.grid.height();h.layers=d.grid.get_num_layers();
+    h.channels=f_wire_cost_map.dim_size(2);h.segments=f_wire_cost_map.dim_size(3);
+    h.sink_base=d.rr_indexed_data[RRIndexedDataId(SINK_COST_INDEX)].base_cost;
+    h.reserved=SINK_COST_INDEX;
+    h.sentinel=ROUTER_LOOKAHEAD_NO_PATH_SENTINEL;h.base_count=d.rr_indexed_data.size();
+    model.wires.reserve(uint64_t(h.layers)*h.layers*h.channels*h.segments*h.width*h.height);
+    for(uint32_t from=0;from<h.layers;++from)for(uint32_t to=0;to<h.layers;++to)
+    for(uint32_t type=0;type<h.channels;++type)for(uint32_t seg=0;seg<h.segments;++seg)
+    for(uint32_t x=0;x<h.width;++x)for(uint32_t y=0;y<h.height;++y){
+        const auto&c=f_wire_cost_map[from][to][type][seg][x][y];model.wires.push_back({c.delay,c.congestion});
+    }
+    std::map<std::tuple<int,int,int>,std::pair<uint32_t,uint32_t>> reach_cache;
+    model.nodes.resize(rr.num_nodes());
+    for(auto id:rr.nodes()){
+        auto& n=model.nodes[size_t(id)];
+        n.xlo=rr.node_xlow(id);n.xhi=rr.node_xhigh(id);n.ylo=rr.node_ylow(id);n.yhi=rr.node_yhigh(id);
+        n.zlo=rr.node_layer_low(id);n.zhi=rr.node_layer_high(id);
+        std::tie(n.adjx,n.adjy)=util::get_adjusted_rr_position(id);
+        n.kind=kind(rr.node_type(id));auto dir=rr.node_direction(id);
+        n.dir=dir==Direction::INC?0:(dir==Direction::DEC?1:2);
+        n.cost_index=size_t(rr.node_cost_index(id));n.capacity=rr.node_capacity(id);
+        n.segment=d.rr_indexed_data[rr.node_cost_index(id)].seg_index;
+        if(n.kind==Source || n.kind==Opin){
+            auto tile=d.grid.get_physical_type({n.xlo,n.ylo,n.zlo});
+            int tile_id=std::distance(&d.physical_tile_types[0],tile),ptc=rr.node_ptc_num(id);
+            auto key=std::make_tuple(n.zlo,tile_id,ptc);auto it=reach_cache.find(key);
+            if(it==reach_cache.end()){
+                uint32_t start=model.reachable.size();
+                for(uint32_t layer=0;layer<h.layers;++layer){
+                    const auto& reachable=src_opin_delays.at(n.zlo).at(tile_id).at(ptc).at(layer);
+                    if(reachable.empty())model.reachable.push_back({Sentinel,0,layer,h.sentinel,h.sentinel});
+                    for(const auto& item:reachable){const auto&r=item.second;
+                        model.reachable.push_back({kind(r.wire_rr_type),uint32_t(r.wire_seg_index),uint32_t(r.layer_number),r.delay,r.congestion});
+                    }
+                }
+                it=reach_cache.emplace(key,std::make_pair(start,uint32_t(model.reachable.size()-start))).first;
+            }
+            std::tie(n.reach_begin,n.reach_count)=it->second;
+        }
+        auto group=d.rr_node_to_non_config_node_set.find(id);
+        n.group_begin=model.groups.size();
+        if(group!=d.rr_node_to_non_config_node_set.end())
+            for(auto member:d.rr_non_config_node_sets[group->second])model.groups.push_back(size_t(member));
+        n.group_count=model.groups.size()-n.group_begin;
+    }
+    h.nodes=model.nodes.size();h.wires=model.wires.size();h.reachable=model.reachable.size();h.groups=model.groups.size();
+    return true;
+}
