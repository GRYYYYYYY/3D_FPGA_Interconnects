+/** @brief Read a positive byte budget; defaults are conservative estimates, not
+ * a guarantee on unbounded native Dijkstra heap growth. */
+static size_t compact_budget_setting(const char* name, size_t fallback) {
+    const char* value = std::getenv(name);
+    if (!value) return fallback;
+    char* end = nullptr;
+    unsigned long long parsed = std::strtoull(value, &end, 10);
+    if (!parsed || !end || *end || value[0] == '-') {
+        VPR_FATAL_ERROR(VPR_ERROR_OTHER, "Invalid positive byte budget %s=%s", name, value);
+    }
+    return static_cast<size_t>(parsed);
+}
