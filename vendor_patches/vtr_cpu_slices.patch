@@ -0,0 +1,55 @@
+#pragma once
+
+#include <chrono>
+#include <cstdlib>
+#include <fstream>
+#include <mutex>
+#include <sstream>
+#include <string>
+#include <sys/resource.h>
+#include <unistd.h>
+
+/** @brief Optional whole-phase diagnostics, disabled in formal measurements. */
+namespace native_cpu_trace {
+inline const char* path() {
+    static const char* value = std::getenv("VPR_CPU_TRACE");
+    return value;
+}
+inline uint64_t now() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+inline uint64_t rss_kib() {
+    std::ifstream input("/proc/self/statm");
+    uint64_t size = 0, resident = 0;
+    input >> size >> resident;
+    return resident * static_cast<uint64_t>(sysconf(_SC_PAGESIZE)) / 1024;
+}
+/** @brief Append an event whose caller supplies only controlled JSON fields. */
+inline void event(const char* name, uint64_t start, const std::string& fields = "") {
+    if (!path()) return;
+    const uint64_t end = now();
+    const uint64_t rss = rss_kib();
+    static std::mutex mutex;
+    std::lock_guard<std::mutex> lock(mutex);
+    std::ofstream output(path(), std::ios::app);
+    output << "{\"event\":\"" << name << "\",\"start_ns\":" << start
+           << ",\"end_ns\":" << end << ",\"duration_ns\":" << end - start
+           << ",\"rss_kib\":" << rss << fields << "}\n";
+}
+/** @brief Record a lexical phase, including exception exits. */
+class Scope {
+  public:
+    explicit Scope(const char* name) : name_(name), start_(path() ? now() : 0) {}
+    ~Scope() { if (path()) event(name_, start_); }
+  private:
+    const char* name_; ///< Stable event name.
+    uint64_t start_; ///< Monotonic timestamp; zero when disabled.
+};
+/** @brief Time one call without changing its return value or exception. */
+template<typename Function>
+decltype(auto) measure(const char* name, Function&& function) {
+    Scope scope(name);
+    return function();
+}
+} // namespace native_cpu_trace
