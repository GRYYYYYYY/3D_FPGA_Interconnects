+void consume_routing_cost_maps_bounded(int longest_seg_length, const std::vector<WireSampleGroup>& groups,
+                                      const CompactGroupConsumer& consume, int route_verbosity,
+                                      bool device_model_warnings) {
+    native_cpu_trace::Scope scheduler_scope("bounded_scheduler");
+    const auto& device_ctx = g_vpr_ctx.device();
+    const auto& grid = device_ctx.grid;
+    const std::array<size_t, 3> shape{grid.get_num_layers(), grid.width(), grid.height()};
+    const size_t map_bytes = shape[0] * shape[1] * shape[2] * sizeof(SmallestCostEntry);
+    const size_t budget = compact_budget_setting("VPR_CPU_LOOKAHEAD_TEMP_BYTES", size_t(512) << 20);
+    const size_t workspace_estimate = compact_budget_setting("VPR_CPU_LOOKAHEAD_WORKSPACE_BYTES",
+        device_ctx.rr_graph.num_nodes() * (sizeof(float) + sizeof(PQ_Entry)) + (size_t(1) << 20));
+    size_t workers = 1;
+#ifdef VPR_USE_TBB
+    workers = tbb::global_control::active_value(tbb::global_control::max_allowed_parallelism);
+#endif
+    workers = std::max(size_t(1), std::min(workers, budget / (workspace_estimate + map_bytes)));
+    const size_t estimated_scratch = workers * workspace_estimate;
+    const size_t result_budget = budget > estimated_scratch ? budget - estimated_scratch : map_bytes;
+    const size_t map_limit = std::max(size_t(1), std::min(2 * workers, result_budget / map_bytes));
+
+    // Only source IDs and group metadata are retained globally, never G cost maps.
+    std::vector<std::vector<RRNodeId>> sources(groups.size());
+    std::vector<size_t> active;
+    for (size_t i = 0; i < groups.size(); ++i) {
+        const auto& group = groups[i];
+        if (!device_ctx.inter_cluster_prog_routing_resources[group.from_layer]) continue;
+        sources[i] = select_wire_samples(longest_seg_length, group.from_layer, group.channel, *group.segment);
+        active.push_back(i);
+        if (sources[i].empty()) {
+            VTR_LOGV_WARN(route_verbosity > 1 || device_model_warnings,
+                         "Unable to find any sample location for segment %s type '%s' (length %d)\n",
+                         rr_node_typename[group.channel], group.segment->name.c_str(), group.segment->length);
+        }
+    }
+    /** @brief Keep each slot's mutable queue headers and counters off neighbours'
+     * cache lines. Thread-private ownership alone does not prevent false sharing. */
+#if defined(__cpp_lib_hardware_interference_size)
+    constexpr size_t workspace_alignment = std::hardware_destructive_interference_size;
+#else
+    // libstdc++ 11 lacks the standard constant. This conservative fallback
+    // covers the tested host's 64-byte lines without changing public ABI.
+    constexpr size_t workspace_alignment = 128;
+#endif
+    struct alignas(workspace_alignment) WorkspaceSlot {
+        t_dijkstra_data data; ///< Exclusively accessed by this logical worker slot.
+    };
+    const char* unaligned_setting = std::getenv("VPR_CPU_LOOKAHEAD_UNALIGNED");
+    const bool unaligned = unaligned_setting && std::strcmp(unaligned_setting, "1") == 0;
+    VTR_LOG("Bounded lookahead: %zu workspace slots, %zu result maps maximum (%zu bytes/map); "
+            "scratch estimate %zu bytes/slot, temporary budget %zu bytes.\n",
+            workers, map_limit, map_bytes, workspace_estimate, budget);
+    native_cpu_trace::event("scheduler_budget", native_cpu_trace::now(),
+        ",\"workers\":" + std::to_string(workers) + ",\"map_limit\":" + std::to_string(map_limit)
+        + ",\"map_bytes\":" + std::to_string(map_bytes) + ",\"workspace_estimate\":" + std::to_string(workspace_estimate)
+        + ",\"budget_bytes\":" + std::to_string(budget)
+        + ",\"workspace_stride\":" + std::to_string(unaligned ? sizeof(t_dijkstra_data) : sizeof(WorkspaceSlot))
+        + ",\"workspace_alignment_bytes\":" + std::to_string(workspace_alignment)
+        + ",\"aligned_workspaces\":" + (unaligned ? "false" : "true"));
+    std::vector<t_dijkstra_data> unaligned_scratch(unaligned ? workers : 0);
+    std::vector<WorkspaceSlot> aligned_scratch(unaligned ? 0 : workers);
+    auto workspace = [&](size_t slot) -> t_dijkstra_data& {
+        return unaligned ? unaligned_scratch[slot] : aligned_scratch[slot].data;
+    };
+    size_t next_group = 0;
+    while (next_group < active.size()) {
+        const size_t first_id = active[next_group];
+        // Unusually large groups or a very small map budget use a single map,
+        // inserting samples in order. This respects the map bound even at P=1.
+        if (sources[first_id].size() > map_limit || sources[first_id].empty()) {
+            CompactCostMap map(shape);
+            for (RRNodeId node : sources[first_id]) flood_wire_sample(node, workspace(0), map, {}, true);
+            consume(first_id, map);
+            ++next_group;
+            continue;
+        }
+        /** @brief Per-active-group storage and completion publication. */
+        struct GroupState {
+            size_t id; ///< Original group index.
+            std::vector<CompactCostMap> maps; ///< One exclusively owned map per sample.
+            std::atomic<size_t> remaining; ///< Release sequence publishes completed maps.
+            GroupState(size_t group_id, size_t count) : id(group_id), maps(count), remaining(count) {}
+        };
+        std::vector<std::unique_ptr<GroupState>> batch;
+        std::vector<std::pair<size_t, size_t>> jobs;
+        while (next_group < active.size()) {
+            const size_t id = active[next_group];
+            const size_t count = sources[id].size();
+            if (count == 0 || jobs.size() + count > map_limit) break;
+            const size_t batch_id = batch.size();
+            batch.push_back(std::make_unique<GroupState>(id, count));
+            for (size_t sample = 0; sample < count; ++sample) jobs.emplace_back(batch_id, sample);
+            ++next_group;
+        }
+        VTR_ASSERT(!jobs.empty());
+        std::atomic<size_t> next_job{0};
+        const uint64_t ready = native_cpu_trace::path() ? native_cpu_trace::now() : 0;
+        auto run_slot = [&](size_t slot) {
+            while (true) {
+                const size_t job = next_job.fetch_add(1, std::memory_order_relaxed);
+                if (job >= jobs.size()) break;
+                const auto [batch_id, sample] = jobs[job];
+                auto& state = *batch[batch_id];
+                const uint64_t start = native_cpu_trace::path() ? native_cpu_trace::now() : 0;
+                state.maps[sample] = native_cpu_trace::measure("allocate_sample", [&] { return CompactCostMap(shape); });
+                flood_wire_sample(sources[state.id][sample], workspace(slot), state.maps[sample], {}, true);
+                if (native_cpu_trace::path()) {
+                    native_cpu_trace::event("scheduled_sample", start,
+                        ",\"group\":" + std::to_string(state.id) + ",\"sample\":" + std::to_string(sample)
+                        + ",\"slot\":" + std::to_string(slot) + ",\"ready_ns\":" + std::to_string(ready)
+                        + ",\"queue_wait_ns\":" + std::to_string(start - ready));
+                }
+                // acq_rel ensures the final worker sees all samples. No worker
+                // waits for a predecessor, and all merges use original sample order.
+                if (state.remaining.fetch_sub(1, std::memory_order_acq_rel) == 1) {
+                    native_cpu_trace::measure("merge_group", [&] {
+                        for (size_t j = 1; j < state.maps.size(); ++j) merge_compact(state.maps[0], state.maps[j]);
+                    });
+                    consume(state.id, state.maps[0]);
+                    native_cpu_trace::measure("release_samples", [&] { state.maps.clear(); });
+                }
+            }
+        };
+#ifdef VPR_USE_TBB
+        tbb::parallel_for(size_t(0), std::min(workers, jobs.size()), run_slot);
+#else
+        run_slot(0);
+#endif
+    }
+    native_cpu_trace::measure("release_workspaces", [&] { aligned_scratch.clear(); unaligned_scratch.clear(); });
+}
