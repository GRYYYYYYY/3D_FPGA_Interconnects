+/** @brief Original-order scalar reduction; equal delay retains the first sample. */
+static void merge_compact(CompactCostMap& target, const CompactCostMap& source) {
+    for (size_t l = 0; l < target.dim_size(0); ++l)
+        for (size_t x = 0; x < target.dim_size(1); ++x)
+            for (size_t y = 0; y < target.dim_size(2); ++y)
+                target[l][x][y].merge_smallest(source[l][x][y]);
