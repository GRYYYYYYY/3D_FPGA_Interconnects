+                     "Unable to find any sample location for segment %s type '%s' (length %d)\n",
+                     rr_node_typename[group.channel], group.segment->name.c_str(), group.segment->length);
+        return result;
+    }
+#ifdef VPR_USE_TBB
+    const char* parallel_setting = std::getenv("VPR_HYBRID_LOOKAHEAD_PARALLEL");
+    if (parallel_setting && std::strcmp(parallel_setting, "1") == 0 && nodes.size() > 1) {
+        std::vector<CompactCostMap> samples(nodes.size());
+        tbb::enumerable_thread_specific<t_dijkstra_data> scratch;
+        tbb::parallel_for(size_t(0), nodes.size(), [&](size_t i) {
+            samples[i] = native_cpu_trace::measure("allocate_sample", [&] {
+                return CompactCostMap({grid.get_num_layers(), grid.width(), grid.height()});
+            });
+            flood_wire_sample(nodes[i], scratch.local(), samples[i], {}, true);
+        });
+        native_cpu_trace::measure("merge_group", [&] {
+            for (const auto& sample : samples) merge_compact(result, sample);
+        });
+        native_cpu_trace::measure("release_samples", [&] { samples.clear(); });
+        native_cpu_trace::measure("release_workspaces", [&] { scratch.clear(); });
+    } else
+#endif
+    {
+        t_dijkstra_data scratch;
+        for (RRNodeId node : nodes) flood_wire_sample(node, scratch, result, {}, true);
+    }
+    return result;
+}
