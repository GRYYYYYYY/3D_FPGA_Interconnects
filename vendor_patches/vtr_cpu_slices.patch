+/** @brief A flood owns its labels and output; the RR graph is immutable. */
+template<typename CostMap>
+static void flood_wire_sample(RRNodeId sample_node, t_dijkstra_data& scratch, CostMap& costs,
+                              const std::unordered_map<int, std::unordered_set<int>>& sample_locs,
+                              bool sample_all_locs) {
