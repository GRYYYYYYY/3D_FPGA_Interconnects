+        VTR_ASSERT(method == SMALLEST);
+        if (!occupied_ || delay < delay_) {
+            delay_ = delay;
+            congestion_ = congestion;
+            occupied_ = true;
+        }
+    }
+    void merge_smallest(const SmallestCostEntry& other) {
+        if (other.occupied_) add_cost_entry(SMALLEST, other.delay_, other.congestion_);
+    }
+    Cost_Entry representative() const {
+        return occupied_ ? Cost_Entry(delay_, congestion_) : Cost_Entry();
+    }
+    bool occupied() const { return occupied_; }
+  private:
+    float delay_ = std::numeric_limits<float>::quiet_NaN(); ///< Minimum recorded delay.
+    float congestion_ = std::numeric_limits<float>::quiet_NaN(); ///< Associated congestion.
+    bool occupied_ = false; ///< Whether any sample was inserted, including a NaN.
+};
+
+using CompactCostMap = vtr::NdMatrix<SmallestCostEntry, 3>;
+using CompactGroupConsumer = std::function<void(size_t, const CompactCostMap&)>;
+
+/** @brief Same per-group sample scheduling as the control, with scalar maps. */
+CompactCostMap get_routing_cost_map_compact(int longest_seg_length, const WireSampleGroup& group,
+                                          int route_verbosity, bool device_model_warnings);
+
+/** @brief Bounded batches of groups with private workspace slots. The last
+ * completed sample reduces its group in original sample order and consumes it.
+ * Result maps are bounded by the budget; scratch/heap estimates are reported
+ * separately and do not constitute a hard cap on total process memory. */
+void consume_routing_cost_maps_bounded(int longest_seg_length, const std::vector<WireSampleGroup>& groups,
+                                      const CompactGroupConsumer& consume, int route_verbosity,
+                                      bool device_model_warnings);
+
+/** @brief Sample all groups through a bounded pipeline with serial-order
+ * reduction. Returned maps follow request order; interpolation stays serial. */
+std::vector<t_routing_cost_map> get_routing_cost_maps_pipeline(
+    int longest_seg_length, const std::vector<WireSampleGroup>& groups,
+    int route_verbosity, bool device_model_warnings);
+
+/** @brief Prior per-group implementation retained for same-binary attribution. */
+t_routing_cost_map get_routing_cost_map_legacy(int longest_seg_length,
+                                        unsigned from_layer_num,
+                                        const e_rr_type chan_type,
+                                        const t_segment_inf& segment_inf,
+                                        const std::unordered_map<int, std::unordered_set<int>>& sample_locs,
+                                        bool sample_all_locs,
+                                        int route_verbosity,
+                                        bool device_model_warnings);
+
