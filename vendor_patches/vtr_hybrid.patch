+
+/** @brief Optional diagnostic ownership of live per-connection search labels. */
+class H3DLabelScope {
+  public:
+    H3DLabelScope(ParentNetId net, RRNodeId sink, const t_bb& box);
+    ~H3DLabelScope();
+    H3DLabelScope(const H3DLabelScope&) = delete;
+    H3DLabelScope& operator=(const H3DLabelScope&) = delete;
+  private:
+    bool active_ = false; ///< Whether the audit is enabled for this connection.
+};
+
+/** @brief Claim a label before a seed/relax/reset write; reject foreign live labels. */
+void h3d_label_claim(RRNodeId node, const char* operation);
+/** @brief Release a label only after its search state has been reset. */
+void h3d_label_release(RRNodeId node);
