+H3DNativeNetLease::H3DNativeNetLease(ParentNetId net,const t_bb&box,int iteration){
+    current_iteration=iteration;
+    if(!requested()||!runtime().batch)return;
+    auto&r=runtime();require(!local_lease,"nested native net lease");
+    // VPR can retain old tree resources outside a later connection/net BB.
+    // Reserve their reference points as well before rip-up or label writes.
+    // This changes only synchronization, never VPR's search bounding box.
+    t_bb domain=box;bool expanded=false;
+    const auto&tree=g_vpr_ctx.routing().route_trees[net];
+    const auto&rr=g_vpr_ctx.device().rr_graph;
+    if(tree)for(const auto&n:tree->root().all_nodes()){
+        if(inside_bb(n.inode,domain))continue;
+        expanded=true;bool dec=rr.node_direction(n.inode)==Direction::DEC;
+        int x=dec?rr.node_xhigh(n.inode):rr.node_xlow(n.inode);
+        int y=dec?rr.node_yhigh(n.inode):rr.node_ylow(n.inode);
+        int z=dec?rr.node_layer_high(n.inode):rr.node_layer_low(n.inode);
+        domain.xmin=std::min(domain.xmin,x);domain.xmax=std::max(domain.xmax,x);
+        domain.ymin=std::min(domain.ymin,y);domain.ymax=std::max(domain.ymax,y);
+        domain.layer_min=std::min(domain.layer_min,z);domain.layer_max=std::max(domain.layer_max,z);
+    }
