+    if(expanded)++r.expanded_leases;
+    auto available=[&]{for(auto other:r.leases)if(other.net==size_t(net)||!disjoint(other.box,domain))return false;return true;};
+    if(!available()){
+        ++r.lease_waits;++r.lease_waiters;uint64_t conflicts=0,expanded_only=0;
+        for(auto other:r.leases)if(other.net==size_t(net)||!disjoint(other.box,domain)){++conflicts;if(disjoint(other.box,box))++expanded_only;}
+        r.event("lease_wait",size_t(net),conflicts,expanded_only);r.lease_cv.wait(lock,available);--r.lease_waiters;r.event("lease_acquired_after_wait",size_t(net));
