+            int tile_id=std::distance(&d.physical_tile_types[0],tile),ptc=rr.node_ptc_num(id);
+            auto key=std::make_tuple(n.zlo,tile_id,ptc);auto it=reach_cache.find(key);
+            if(it==reach_cache.end()){
+                uint32_t start=model.reachable.size();
+                for(uint32_t layer=0;layer<h.layers;++layer){
+                    const auto& reachable=src_opin_delays.at(n.zlo).at(tile_id).at(ptc).at(layer);
+                    if(reachable.empty())model.reachable.push_back({Sentinel,0,layer,h.sentinel,h.sentinel});
