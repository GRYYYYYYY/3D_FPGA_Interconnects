+#include "model_io.hpp"
+#include "gpu_api.hpp"
+
+namespace {
+using Clock = std::chrono::steady_clock;
+uint64_t ns(Clock::time_point a) {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now()-a).count();
+}
+template<class T> void write(std::ofstream& f, const T& v) {
+    f.write(reinterpret_cast<const char*>(&v), sizeof(v));
+}
+template<class T> void write_vector(std::ofstream& f, const std::vector<T>& v) {
+    f.write(reinterpret_cast<const char*>(v.data()), sizeof(T)*v.size());
+}
+struct Recorder {
+    std::filesystem::path directory;
+    std::ofstream csv;
+    uint64_t sequence = 0, captured = 0;
+    std::array<unsigned,64> bins{};
+    bool graph_written = false, graph_supported = true;
+    bool model_attempted = false;
+    std::vector<h3d_native::State> last_state;
+    Recorder() {
+        directory = std::getenv("VPR_HYBRID_PROFILE");
+        if (!std::filesystem::create_directory(directory))
+            throw std::runtime_error("VPR_HYBRID_PROFILE directory must not already exist");
+        csv.open(directory/"queries.csv");
+        csv.exceptions(std::ios::badbit | std::ios::failbit);
+        csv << "sequence,net,pin,sink,criticality,seeds,box_volume,cpu_ns,heap_pops,heap_pushes,found,cost,capture,prepare_ns\n";
+        csv << std::setprecision(9);
+    }
+    bool graph() {
+        if (graph_written) return graph_supported;
+        graph_written = true;
+        const auto& d = g_vpr_ctx.device(); const auto& rr = d.rr_graph;
+        for (auto n:rr.nodes()) if (rr.node_R(n)!=0.f || rr.node_C(n)!=0.f) graph_supported=false;
+        for (const auto& sw:rr.rr_switch()) if (sw.R!=0.f) graph_supported=false;
+        if (!graph_supported) return false;
+        h3d_native::GraphHeader header;
+        size_t edge_count=0;for(auto n:rr.nodes())edge_count+=rr.num_edges(n);
+        header.nodes=rr.num_nodes(); header.edges=edge_count;
+        if (size_t(header.nodes)!=rr.num_nodes() || size_t(header.edges)!=edge_count)
+            throw std::runtime_error("native snapshot exceeds 32-bit graph ABI");
+        std::vector<h3d_native::Node> nodes(header.nodes);
+        std::vector<h3d_native::Edge> edges; edges.reserve(header.edges);
+        for (auto n:rr.nodes()) {
+            nodes[size_t(n)]={uint32_t(edges.size()),0};
+            for (auto e:rr.edge_range(n)) {
+                auto to=rr.edge_sink_node(e);
+                auto ft=rr.node_type(n),tt=rr.node_type(to);
+                bool bend=(ft==e_rr_type::CHANX && tt==e_rr_type::CHANY) || (ft==e_rr_type::CHANY && tt==e_rr_type::CHANX);
+                edges.push_back({uint32_t(size_t(n)),uint32_t(size_t(to)),uint32_t(size_t(e)),
+                    get_rr_node_delay_cost(to,e),uint32_t(rr.rr_switch()[RRSwitchId(rr.edge_switch(e))].configurable()),uint32_t(bend)});
+                ++nodes[size_t(n)].count;
+            }
+        }
+        if (edges.size()!=header.edges) throw std::runtime_error("native snapshot edge coverage mismatch");
+        std::ofstream f(directory/"graph.bin",std::ios::binary);
+        f.exceptions(std::ios::badbit | std::ios::failbit);
+        write(f,header);write_vector(f,nodes);write_vector(f,edges);
+        return true;
+    }
+};
+Recorder& recorder() { static Recorder r; return r; }
