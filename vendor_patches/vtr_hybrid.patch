+#include "h3d_label_audit.h"
+
+#include <cstdlib>
+#include <fstream>
+#include <map>
+#include <mutex>
+#include <thread>
+#include <vector>
+#include "globals.h"
+#include "vpr_error.h"
+
+namespace {
+struct LabelContext {
+    size_t net;
+    size_t sink;
+    t_bb box;
+};
+struct Audit {
+    std::mutex mutex;
+    std::vector<uint64_t> owners;
+    std::map<uint64_t, LabelContext> contexts;
+    uint64_t next = 0;
+};
+thread_local uint64_t token = 0;
+thread_local std::vector<RRNodeId> claimed;
+
+/** @brief Return the optional report path, cached before any connection writes. */
+const char* report_path() {
+    static const char* path = std::getenv("VPR_HYBRID_LABEL_AUDIT");
+    return path;
+}
+/** @brief Process-wide audit state; synchronization changes are diagnostic only. */
+Audit& audit() {
+    static Audit value;
+    return value;
+}
+/** @brief Write the network and box associated with one active connection. */
+void context_json(std::ostream& out, const LabelContext& c) {
+    out << "{\"net\":" << c.net << ",\"sink\":" << c.sink
+        << ",\"box\":[" << c.box.xmin << ',' << c.box.xmax << ',' << c.box.ymin << ',' << c.box.ymax
+        << ',' << c.box.layer_min << ',' << c.box.layer_max << "]}";
+}
+}
+
+H3DLabelScope::H3DLabelScope(ParentNetId net, RRNodeId sink, const t_bb& box) {
+    if (!report_path()) return;
+    VTR_ASSERT(token == 0);
+    Audit& a = audit();
+    std::lock_guard<std::mutex> lock(a.mutex);
+    if (a.owners.empty()) a.owners.resize(g_vpr_ctx.device().rr_graph.num_nodes(), 0);
+    token = ++a.next;
+    a.contexts.emplace(token, LabelContext{size_t(net), size_t(sink), box});
+    active_ = true;
+}
+
+H3DLabelScope::~H3DLabelScope() {
+    if (!active_) return;
+    Audit& a = audit();
+    std::lock_guard<std::mutex> lock(a.mutex);
+    for (RRNodeId node : claimed) {
+        if (a.owners[size_t(node)] == token) a.owners[size_t(node)] = 0;
+    }
+    claimed.clear();
+    a.contexts.erase(token);
+    token = 0;
+}
+
+void h3d_label_claim(RRNodeId node, const char* operation) {
+    if (!token) return;
+    Audit& a = audit();
+    std::lock_guard<std::mutex> lock(a.mutex);
+    uint64_t& owner = a.owners.at(size_t(node));
+    if (owner != 0 && owner != token) {
+        const auto& rr = g_vpr_ctx.device().rr_graph;
+        std::ofstream out(report_path(), std::ios::app);
+        out << "{\"event\":\"live_label_collision\",\"node\":" << size_t(node)
+            << ",\"operation\":\"" << operation << "\",\"location\":["
+            << rr.node_xlow(node) << ',' << rr.node_ylow(node) << ',' << int(rr.node_layer_low(node))
+            << "],\"owner\":";
+        context_json(out, a.contexts.at(owner));
+        out << ",\"contender\":";
+        context_json(out, a.contexts.at(token));
+        out << "}\n";
+        out.flush();
+        VPR_FATAL_ERROR(VPR_ERROR_ROUTE, "Live predecessor label collision at RR node %zu; see %s", size_t(node), report_path());
+    }
+    if (owner == 0) {
+        owner = token;
+        claimed.push_back(node);
+    }
+}
+
+void h3d_label_release(RRNodeId node) {
+    if (!token) return;
+    Audit& a = audit();
+    std::lock_guard<std::mutex> lock(a.mutex);
+    VTR_ASSERT(a.owners.at(size_t(node)) == token);
+    a.owners[size_t(node)] = 0;
+}
