+H3DNativeNetLease::~H3DNativeNetLease(){
+    if(!held_)return;
+    auto&r=runtime();
+    {std::lock_guard<std::mutex> lock(r.lease_mutex);
+     auto it=std::find_if(r.leases.begin(),r.leases.end(),[](const Lease&v){return v.net==local_lease->net;});
+     r.leases.erase(it);--r.leases_held;local_lease.reset();}
+    r.lease_cv.notify_all();
+}
