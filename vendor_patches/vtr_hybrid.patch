+void h3d_native_partition_queued(){if(requested()&&runtime().diagnostic)++runtime().partitions_queued;}
+H3DNativePartitionScope::H3DNativePartitionScope(const void*id,int depth,bool children,size_t nets,int iteration){
+    if(!requested()||!runtime().diagnostic)return;
+    enabled_=true;branch_=children;current_iteration=iteration;auto&r=runtime();current_partition=reinterpret_cast<uintptr_t>(id);current_depth=depth;current_remaining_nets=nets;
+    --r.partitions_queued;++r.partitions_active;if(branch_)++r.branch_parents;r.event("partition_begin");
+}
+H3DNativePartitionScope::~H3DNativePartitionScope(){
+    if(!enabled_)return;
+    auto&r=runtime();r.event("partition_end");--r.partitions_active;if(branch_)--r.branch_parents;
+    current_partition=0;current_depth=0;current_remaining_nets=0;
+}
+void H3DNativePartitionScope::net_started(){if(enabled_&&current_remaining_nets)--current_remaining_nets;}
+H3DNativeSearchScope::H3DNativeSearchScope(){if(requested()&&runtime().diagnostic){enabled_=true;++runtime().searches_active;}}
+H3DNativeSearchScope::~H3DNativeSearchScope(){if(enabled_)--runtime().searches_active;}
+
+H3DNativeCommitScope::H3DNativeCommitScope(RRNodeId sink){
+    if(requested()&&runtime().diagnostic&&commit_ready&&pending.query.sink==size_t(sink)){
+        enabled_=true;commit_ready=false;start_=Clock::now();
+    }
+}
+H3DNativeCommitScope::~H3DNativeCommitScope(){
+    if(!enabled_)return;
+    auto elapsed=ns(start_);auto&r=runtime();auto&p=pending;
+    std::lock_guard<std::mutex> lock(r.report_mutex);
+    r.commit_csv<<p.sequence<<','<<p.batch_id<<','<<p.net<<','<<p.query.sink<<','<<elapsed<<'\n';
+}
