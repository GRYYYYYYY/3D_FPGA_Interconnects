# Caller opens the selected completed impl run and sets cp_report_dir.
report_utilization -file [file join $cp_report_dir route_utilization.rpt]
report_utilization -hierarchical -hierarchical_depth 4 -file [file join $cp_report_dir route_hierarchy.rpt]
report_timing_summary -delay_type min_max -report_unconstrained -max_paths 20 -file [file join $cp_report_dir route_timing.rpt]
report_timing -delay_type max -max_paths 20 -path_type full_clock_expanded -file [file join $cp_report_dir setup_paths.rpt]
report_timing -delay_type min -max_paths 20 -path_type full_clock_expanded -file [file join $cp_report_dir hold_paths.rpt]
report_route_status -file [file join $cp_report_dir route_status.rpt]
report_drc -file [file join $cp_report_dir route_drc.rpt]
report_methodology -file [file join $cp_report_dir methodology.rpt]
check_timing -verbose -file [file join $cp_report_dir check_timing.rpt]
report_clocks -file [file join $cp_report_dir clocks.rpt]
report_exceptions -file [file join $cp_report_dir exceptions.rpt]
write_checkpoint -force [file join $cp_report_dir full_route.dcp]
write_xdc -force [file join $cp_report_dir actual_constraints.xdc]
